  $psi.Arguments = '-NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand VwByAGkAdABlAC0ASABvAHMAdAAgACcAbQBpAG4AZQAnAA=='
  $psi.UseShellExecute = $false
